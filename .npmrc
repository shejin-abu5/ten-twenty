# better-sqlite3 ships prebuilt binaries for every platform it supports,
# darwin-arm64 and darwin-x64 included, so it needs no compilation. npm still
# sees its binding.gyp and tries an implicit `node-gyp rebuild`, which fails on
# any machine without Python and a C++ toolchain.
#
# Nothing in this dependency tree needs an install script, so they are skipped.
# Verified from a clean clone: install, seed, test, reconcile and build all pass.
ignore-scripts=true
